root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml,json,js,jsx,ts,tsx,css,html}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = tab

[Makefile]
indent_style = tab

[*.sh]
indent_style = space
indent_size = 2
